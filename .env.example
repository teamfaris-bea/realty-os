# Copy to .env. Never commit real secrets.
DATABASE_URL=postgres://app_user:app_user_dev@localhost:5432/realty_dev
MIGRATION_DATABASE_URL=postgres://app_owner:dev@localhost:5432/realty_dev
# Maintenance connection for the per-test database helper (packages/db/src/testing).
# Must be a role that can CREATE DATABASE; defaults to MIGRATION_DATABASE_URL with database "postgres".
TEST_ADMIN_DATABASE_URL=postgres://app_owner:dev@localhost:5432/postgres
SESSION_COOKIE_SECURE=false
# 32-byte base64 key-encryption key for field-level envelope encryption
KEK_BASE64=
# 32-byte base64 server secret: CSRF token HMAC (x-csrf-token = HMAC(secret, session_id))
SESSION_SECRET_BASE64=
API_PORT=3001
# Origin allowlist for CSRF/CORS (comma-separated)
WEB_ORIGIN=http://localhost:5173
ANTHROPIC_API_KEY=
AI_PROVIDER=fake
# fake (default) or twilio / smtp — the real adapters need the credentials below (lane production-readiness)
TELEPHONY_PROVIDER=fake
EMAIL_PROVIDER=fake
STORAGE_DIR=.storage
# --- api/platform (BUILD_PLAN module 8) ---
# Public base URL of the API (Twilio-style webhook signatures are computed over it; reset links)
PUBLIC_BASE_URL=http://localhost:3001
# Trust X-Forwarded-For from the edge proxy (production behind a load balancer only)
TRUST_PROXY=false
# Reference stored in tenant_keys.kek_ref for the KEK that wrapped a key
KEK_REF=local-kek:v1
# Provider webhook signing secrets (dev derives them from SESSION_SECRET_BASE64 when empty; required in production)
TELEPHONY_WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=
LEAD_WEBHOOK_SECRET=
# AI_PROVIDER=anthropic uses the Anthropic API (needs ANTHROPIC_API_KEY); AI_MODEL overrides the default model
AI_MODEL=
# local (encrypted files under STORAGE_DIR), s3 (S3-compatible, see S3_*) or fake (in-memory)
STORAGE_PROVIDER=local
# fake or webpush (needs VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT)
PUSH_PROVIDER=fake
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# General per-session/IP request budget per minute (auth routes add DB-backed limits)
GLOBAL_RATE_LIMIT_PER_MINUTE=600
LOG_LEVEL=info
# api/imports: Follow Up Boss adapter. fake (default) or real (HTTP adapter; VERIFY against a live account first)
FUB_PROVIDER=fake
# optional overrides for FUB_PROVIDER=real: API base URL and FUB registered-system headers (X-System / X-System-Key)
FUB_BASE_URL=
FUB_SYSTEM_NAME=
FUB_SYSTEM_KEY=
# --- production readiness (docs/DEPLOY.md has the full reference) ---
# NODE_ENV=production refuses fakes unless ALLOW_FAKE_PROVIDERS=true (a staging demo only)
ALLOW_FAKE_PROVIDERS=
# Twilio (TELEPHONY_PROVIDER=twilio): master account; tenants get subaccounts automatically
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# sender of account-security codes on the master account: an E.164 number or a Messaging Service SID (MG...)
TWILIO_PLATFORM_SENDER=
TWILIO_NUMBER_COUNTRY=US
# SMTP (EMAIL_PROVIDER=smtp): any relay (Postmark, Amazon SES, SendGrid, Mailgun)
SMTP_HOST=
SMTP_PORT=
# starttls (default, port 587), tls (implicit, 465) or none (local relays only; refused in production)
SMTP_SECURE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# generic | postmark | sendgrid | ses | mailgun: adds the vendor's metadata header so bounce/complaint webhooks echo our ref
SMTP_VENDOR=generic
SMTP_POSTMARK_MESSAGE_STREAM=
SMTP_SES_CONFIGURATION_SET=
# domain checks: DKIM selectors to look up and the vendor's SPF include
EMAIL_DKIM_SELECTORS=
EMAIL_SPF_INCLUDE=
# sender of password-reset and invite emails
ACCOUNT_EMAIL_FROM=
ACCOUNT_EMAIL_FROM_NAME=Realty OS
# vendor inbound/event webhook formats to accept (comma-separated: postmark, sendgrid); empty = generic signed format only
EMAIL_INBOUND_FORMATS=
# HTTP Basic credentials embedded in the vendor webhook URLs (https://user:pass@host/api/webhooks/email/...)
EMAIL_WEBHOOK_BASIC_USER=
EMAIL_WEBHOOK_BASIC_PASSWORD=
# SendGrid Event Webhook verification key (base64, from the SendGrid console)
SENDGRID_EVENT_PUBLIC_KEY=
# S3-compatible storage (STORAGE_PROVIDER=s3): AWS S3, Cloudflare R2, MinIO
S3_BUCKET=
S3_REGION=
# custom endpoint for R2/MinIO, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=
# none (default) | AES256 | aws:kms (+ S3_KMS_KEY_ID); objects are envelope-encrypted by the app either way
S3_SSE=none
S3_KMS_KEY_ID=
# graceful stop: how long /api/ready reports 503 before the server stops accepting, and the hard deadline
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=30000
# worker liveness endpoint (GET /health) for container health checks; empty = off
WORKER_HEALTH_PORT=
