# The app VM's secret REFERENCES (docker-compose.app-vm.yml, docs/DEPLOY.md §12): one NAME=<secret-ref> per line,
# never a value. deploy/render-secrets.sh fetches each reference with the operator's own $SECRET_FETCH_CMD and
# writes NAME=value into /run/realty/app.env (mode 0600). A reference is [A-Za-z0-9/_.:@-]+; replace every
# <secret-ref>. A fetched value that is empty, or holds a character outside [A-Za-z0-9+/=:._@%,~-], is refused (E487):
# generate keys with `openssl rand -base64 32` and webhook secrets with `openssl rand -hex 32`. Delete the line of a
# secret your vendors do not use (an empty value is refused); FUB_SYSTEM_KEY needs FUB_SYSTEM_NAME in the settings.
#
# No owner credential here (MIGRATION_DATABASE_URL is in owner.secrets.refs, for the release step only) and no libpq
# PG* variable: the renderer refuses them (E488).
#
# Operators who enable the metrics listener or error reporting add METRICS_TOKEN and ERROR_REPORTING_DSN here as
# references too (they are not in deploy/env.production.example).

# the app role's URL, password included (postgres://app_user:<password>@<db-host>:5432/realty, no query string)
DATABASE_URL=<secret-ref>
KEK_BASE64=<secret-ref>
SESSION_SECRET_BASE64=<secret-ref>
LEAD_WEBHOOK_SECRET=<secret-ref>
EMAIL_WEBHOOK_SECRET=<secret-ref>
TELEPHONY_WEBHOOK_SECRET=<secret-ref>
ANTHROPIC_API_KEY=<secret-ref>
VAPID_PRIVATE_KEY=<secret-ref>
TWILIO_AUTH_TOKEN=<secret-ref>
SMTP_PASSWORD=<secret-ref>
EMAIL_WEBHOOK_BASIC_PASSWORD=<secret-ref>
MAILGUN_WEBHOOK_SIGNING_KEY=<secret-ref>
S3_ACCESS_KEY_ID=<secret-ref>
S3_SECRET_ACCESS_KEY=<secret-ref>
FUB_SYSTEM_KEY=<secret-ref>
