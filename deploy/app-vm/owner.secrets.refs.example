# The database OWNER's secret reference, for the release step (migrations) only (docs/DEPLOY.md §3, §12).
# Rendered in owner mode (settings argument `-`), which refuses any other line (E488):
#
#   deploy/render-secrets.sh - owner.secrets.refs /run/realty/owner.env
#   docker compose -f docker-compose.app-vm.yml --profile release run --rm release
#   rm /run/realty/owner.env
#
# Only the release profile reads owner.env; api and worker refuse to start with an owner credential.
# The value: postgres://<owner-role>:<password>@<db-host>:5432/realty (no query string).
MIGRATION_DATABASE_URL=<secret-ref>
