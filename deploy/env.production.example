# Production environment for docker-compose.prod.yml (copy to .env.production; never commit the copy).
# Every line without a default must be filled. The API refuses to start and names what is missing.
# Generate keys with:  openssl rand -base64 32

NODE_ENV=production

# ---- compose's own Postgres (skip when you use a managed database) ----
# POSTGRES_OWNER_USER/PASSWORD must be the user and password inside MIGRATION_DATABASE_URL below
POSTGRES_OWNER_USER=realty_owner
POSTGRES_OWNER_PASSWORD=
POSTGRES_DB=realty

# ---- database: two DIFFERENT roles ----
# owner: runs migrations in the release step only
MIGRATION_DATABASE_URL=postgres://realty_owner:CHANGE_ME@postgres:5432/realty
# app: the RLS-bound login every api/worker process uses (the release step creates/aligns it)
DATABASE_URL=postgres://app_user:CHANGE_ME_TOO@postgres:5432/realty

# ---- public URLs (https only) ----
PUBLIC_BASE_URL=https://app.example.com
WEB_ORIGIN=https://app.example.com
TRUST_PROXY=true
SESSION_COOKIE_SECURE=true

# ---- keys ----
KEK_BASE64=
# required in production: the name stamped on every key the KEK wraps (rotation gives the new KEK a new ref, §9)
KEK_REF=prod-kek:v1
SESSION_SECRET_BASE64=
# webhook secrets: each one different (openssl rand -hex 32)
LEAD_WEBHOOK_SECRET=
# required in production only with TELEPHONY_PROVIDER=fake (a staging demo); with Twilio each subaccount signs
TELEPHONY_WEBHOOK_SECRET=
# required in production when EMAIL_INBOUND_FORMATS is empty (the generic signed format), or for a bridge
EMAIL_WEBHOOK_SECRET=
# fake providers in production are refused unless this is true: staging demos only, never for real teams.
# A fake-provider staging template is deploy/env.staging.example (docs/STAGING.md).
ALLOW_FAKE_PROVIDERS=false

# ---- AI and push ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
PUSH_PROVIDER=webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ---- telephony ----
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PLATFORM_SENDER=

# ---- email ----
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_VENDOR=postmark
SMTP_POSTMARK_MESSAGE_STREAM=outbound
EMAIL_DKIM_SELECTORS=
EMAIL_SPF_INCLUDE=spf.mtasv.net
ACCOUNT_EMAIL_FROM=no-reply@example.com
EMAIL_INBOUND_FORMATS=postmark
EMAIL_WEBHOOK_BASIC_USER=
EMAIL_WEBHOOK_BASIC_PASSWORD=
# SES relay (SMTP_VENDOR=ses): add ses to EMAIL_INBOUND_FORMATS and list the SNS topic ARN(s) of its event destination
SES_SNS_TOPIC_ARNS=
# Mailgun relay (SMTP_VENDOR=mailgun): add mailgun to EMAIL_INBOUND_FORMATS and set the webhook signing key
MAILGUN_WEBHOOK_SIGNING_KEY=

# ---- storage ----
# s3, or local: encrypted files under STORAGE_DIR, an absolute path on a persistent, backed-up volume
# (docker-compose.prod.yml mounts the `storage` volume at /var/lib/realty/storage)
STORAGE_PROVIDER=s3
STORAGE_DIR=/var/lib/realty/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SSE=none

# ---- Follow Up Boss import (SECURITY §2.9) ----
# real = the HTTP adapter for API-key imports (VERIFY against a live account first); fake is the dev/test stand-in
FUB_PROVIDER=real
# leave both empty for FUB's own API (https://api.followupboss.com/v1). A custom base URL must be https on the
# default port, without credentials, and its host must be in FUB_ALLOWED_HOSTS (lowercase host names, comma-separated)
FUB_BASE_URL=
FUB_ALLOWED_HOSTS=
# FUB registered-system headers (X-System / X-System-Key), both or neither
FUB_SYSTEM_NAME=
FUB_SYSTEM_KEY=

# ---- Spark MLS (read-only, DEPLOY §11) ----
# fake, or spark (no variable ever holds the token). MLS_LIVE_CALLS is the kill switch: false until §11.5 is signed off
MLS_PROVIDER=fake
MLS_LIVE_CALLS=false

LOG_LEVEL=info
