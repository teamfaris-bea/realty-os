# The database OWNER's credentials for docker-compose.prod.yml (copy to .env.owner next to it, mode 600; never commit
# the copy). The owner is the superuser that creates roles and runs migrations. Only the postgres service and the
# release step read these, by interpolation from `docker compose --env-file .env.owner`: never put them in
# .env.production, which the internet-facing api and worker read (both refuse to start in production with
# MIGRATION_DATABASE_URL, POSTGRES_OWNER_PASSWORD or POSTGRES_PASSWORD in their environment; docs/DEPLOY.md §3).
# One-off owner commands take this file explicitly (DEPLOY §9, STAGING §5-§6).
# With a managed database the POSTGRES_* lines are unused: set MIGRATION_DATABASE_URL to the provider's admin role.
# The same database TLS settings apply to the owner's connection (DATABASE_SSL_MODE, DATABASE_SSL_CA_FILE, in the app's
# file; no query string in the URL). On the app VM this file is replaced by deploy/app-vm/owner.secrets.refs.example
# (docs/DEPLOY.md §12).
# The password: openssl rand -hex 24 (`sh deploy/fill-staging-env.sh <staging-host> <db-host> owner` fills this file).
POSTGRES_OWNER_USER=realty_owner
POSTGRES_OWNER_PASSWORD=
POSTGRES_DB=realty
# the same user and password; <db-host> is `postgres` with the compose database
MIGRATION_DATABASE_URL=postgres://realty_owner:<owner-password>@<db-host>:5432/realty
