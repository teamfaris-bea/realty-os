# Fake-provider STAGING environment (docs/STAGING.md). Copy it OUTSIDE the repository (for example to
# /etc/realty/staging.env, mode 600, or into your secret manager) and fill every empty value:
#   keys:      openssl rand -base64 32      (KEK_BASE64, SESSION_SECRET_BASE64: two different keys)
#   secrets:   openssl rand -hex 32         (each *_WEBHOOK_SECRET different)
#   passwords: openssl rand -hex 24
# deploy/fill-staging-env.sh does exactly that (it prints the filled file; it never writes into the repository).
# Nothing here reaches a real vendor: telephony, email, AI and push are the deterministic fakes, the MLS feed
# is the fake with live calls off, and Follow Up Boss imports use the fake connector.
# deploy/env.staging.example is loaded by apps/api/src/deploy.env.test.ts: keep it loadable.

NODE_ENV=production

# ---- database: the app role only (it must be app_user: the migrations grant to it) ----
# The OWNER role is NOT here: deploy/env.owner.example (.env.owner; `fill-staging-env.sh ... owner` fills it), read
# only by the postgres service and the release step. <db-host> is `postgres` with the compose database.
DATABASE_URL=postgres://app_user:<app-password>@<db-host>:5432/realty
# STAGING ONLY: the compose database is on the same VM's network, so its connection carries no TLS. Production refuses
# disable unless ALLOW_FAKE_PROVIDERS=true; a real deployment uses verify-full to its own database host (DEPLOY §12).
DATABASE_SSL_MODE=disable

# ---- public origin: https only, the one origin that serves the web app and /api ----
PUBLIC_BASE_URL=https://<staging-host>
WEB_ORIGIN=https://<staging-host>
# the proxies whose X-Forwarded-For the API believes: the web container (nginx) on the compose network. Never `true`
# (the API refuses it: a client could then pick its own IP for every per-IP limit). DEPLOY §4.
TRUST_PROXY=uniquelocal
SESSION_COOKIE_SECURE=true

# ---- keys (staging gets its OWN keys; never production's) ----
KEK_BASE64=
KEK_REF=staging-kek:v1
SESSION_SECRET_BASE64=
LEAD_WEBHOOK_SECRET=
TELEPHONY_WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=

# ---- fakes only: the explicit flag is required for fakes under NODE_ENV=production ----
ALLOW_FAKE_PROVIDERS=true
AI_PROVIDER=fake
PUSH_PROVIDER=fake
TELEPHONY_PROVIDER=fake
EMAIL_PROVIDER=fake
EMAIL_INBOUND_FORMATS=
FUB_PROVIDER=fake
MLS_PROVIDER=fake
MLS_LIVE_CALLS=false
TELEPHONY_LIVE_REQUESTS=false
# every live switch at its off value, as in the other templates (b12 review deploy-2): the AI ISA (D12 proposed) and
# the county public-records connector (D10) stay off on staging
AI_ISA_LIVE_SENDS=false
PUBLIC_RECORDS_PROVIDER=fake
PUBLIC_RECORDS_LIVE_CALLS=false

# ---- storage: encrypted local files on a persistent, backed-up volume ----
STORAGE_PROVIDER=local
STORAGE_DIR=/var/lib/realty/storage

# ---- metrics: its own port, bearer token required in production (docs/OPERATIONS.md) ----
# 0.0.0.0 inside a container (the token is then required); each process on one host needs its own port
METRICS_HOST=0.0.0.0
METRICS_PORT=9464
METRICS_TOKEN=

LOG_LEVEL=info
