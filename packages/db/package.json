{
  "name": "@realty/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Migrations, Kysely schema types, tenant transactions, ownership/consent persistence, job queue (BUILD_PLAN module 7).",
  "exports": {
    ".": {
      "@realty/source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "@realty/source": "./src/migrate.ts",
      "types": "./src/migrate.ts",
      "default": "./dist/migrate.js"
    },
    "./testing": {
      "@realty/source": "./src/testing/index.ts",
      "types": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx src/scripts/migrate.ts",
    "setup-dev": "tsx src/scripts/setup-dev.ts",
    "counsel-review": "tsx src/scripts/counsel-review.ts",
    "gen-schema": "tsx --conditions=@realty/source src/schemaGen.ts"
  },
  "dependencies": {
    "@realty/core": "workspace:*",
    "kysely": "0.29.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
