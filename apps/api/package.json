{
  "name": "@realty/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify API + worker (BUILD_PLAN modules 8-16). One build, two entrypoints: src/main.ts (http) and src/worker/main.ts (worker).",
  "exports": {
    ".": {
      "@realty/source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=@realty/source src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env --conditions=@realty/source src/worker/main.ts",
    "seed": "tsx --env-file-if-exists=../../.env --conditions=@realty/source src/seed/main.ts",
    "demo:totp": "tsx --env-file-if-exists=../../.env --conditions=@realty/source src/seed/totp.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker/main.js",
    "load:seed": "tsx --env-file-if-exists=../../.env --conditions=@realty/source src/load/seed.ts",
    "start:synthetic": "node dist/observability/syntheticMain.js",
    "ops:synthetic": "tsx --env-file-if-exists=../../.env --conditions=@realty/source src/observability/syntheticMain.ts",
    "load:bench": "tsx --env-file-if-exists=../../.env --conditions=@realty/source src/load/bench.ts",
    "load:smoke": "tsx --env-file-if-exists=../../.env --conditions=@realty/source src/load/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "@realty/core": "workspace:*",
    "@realty/db": "workspace:*",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "kysely": "0.29.8",
    "openapi-types": "12.1.3",
    "otplib": "13.6.0",
    "pg": "8.23.1",
    "uuid": "14.0.3",
    "web-push": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
