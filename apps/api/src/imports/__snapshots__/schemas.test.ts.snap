exports[`api/imports route table and schemas > R-PERM-13: every import route is \`import.run\` (Owner/Admin 🔒) and carries authorize(import.run) (snapshot) 1`] = `
[
  "GET /api/imports",
  "GET /api/imports/:id",
  "GET /api/imports/:id/parity",
  "GET /api/imports/:id/report",
  "GET /api/imports/:id/stages/:category/records",
  "GET /api/imports/:id/stages/:category/verification",
  "GET /api/imports/:id/user-mappings",
  "POST /api/imports",
  "POST /api/imports/:id/abandon",
  "POST /api/imports/:id/records/:rid/review",
  "POST /api/imports/:id/revert",
  "POST /api/imports/:id/snapshot",
  "POST /api/imports/:id/stages/:category/approve",
  "POST /api/imports/:id/stages/:category/commit",
  "POST /api/imports/:id/stages/:category/dry-run",
  "POST /api/imports/:id/stages/:category/skip",
  "POST /api/imports/:id/stages/:category/verify",
  "PUT /api/imports/:id/csv-mapping",
  "PUT /api/imports/:id/parity",
  "PUT /api/imports/:id/user-mappings",
]
`;
