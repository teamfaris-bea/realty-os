exports[`route table and schemas > every api/people route declares its authorization and carries authorize(<that action>) (snapshot) 1`] = `
[
  "GET /api/contacts/:id/details → contact.view_detail",
  "HEAD /api/contacts/:id/details → contact.view_detail",
  "PATCH /api/contacts/:id → contact.edit",
  "POST /api/contacts/:id/stage → contact.edit",
  "GET /api/stage-labels → self",
  "HEAD /api/stage-labels → self",
  "PUT /api/stage-labels → settings.stage_labels",
  "POST /api/contacts/:id/do-not-contact → contact.edit",
  "GET /api/contacts/:id/points → contact.view_detail",
  "HEAD /api/contacts/:id/points → contact.view_detail",
  "POST /api/contacts/:id/points → contact.edit",
  "POST /api/contacts/:id/points/:pointId/replace → contact.edit",
  "POST /api/contacts/:id/points/:pointId/remove → contact.edit",
  "POST /api/contacts/:id/points/:pointId/primary → contact.edit",
  "PATCH /api/contacts/:id/points/:pointId → contact.edit",
  "POST /api/contacts/:id/addresses → contact.edit",
  "PATCH /api/contacts/:id/addresses/:addressId → contact.edit",
  "GET /api/contacts/:id/collaborators → contact.view_detail",
  "HEAD /api/contacts/:id/collaborators → contact.view_detail",
  "POST /api/contacts/:id/collaborators → collaborator.manage",
  "DELETE /api/contacts/:id/collaborators/:userId → collaborator.manage",
  "GET /api/contacts/:id/relationships → contact.view_detail",
  "HEAD /api/contacts/:id/relationships → contact.view_detail",
  "POST /api/contacts/:id/relationships → contact.edit",
  "DELETE /api/contacts/:id/relationships/:relationshipId → contact.edit",
  "GET /api/contacts/:id/notes → contact.view_detail",
  "HEAD /api/contacts/:id/notes → contact.view_detail",
  "GET /api/contacts/:id/mention-candidates → note.write",
  "HEAD /api/contacts/:id/mention-candidates → note.write",
  "POST /api/contacts/:id/notes → note.write",
  "PATCH /api/notes/:id → note.write",
  "POST /api/notes/:id/pin → note.write",
  "DELETE /api/notes/:id → note.delete",
  "POST /api/contacts/:id/activities → activity.log",
]
`;
