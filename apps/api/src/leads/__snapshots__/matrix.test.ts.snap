exports[`route table and schemas > every leads route declares its authorization and carries authorize(<that action>) (snapshot); intake is a signed webhook 1`] = `
[
  "POST /api/intake/:sourceToken → webhook",
  "GET /api/lead-sources → settings.routing",
  "HEAD /api/lead-sources → settings.routing",
  "POST /api/lead-sources → settings.routing",
  "GET /api/contacts/:id → contact.view",
  "HEAD /api/contacts/:id → contact.view",
  "POST /api/contacts → contact.create",
  "GET /api/contacts/:id/timeline → contact.view_detail",
  "HEAD /api/contacts/:id/timeline → contact.view_detail",
  "POST /api/leads/:contactId/accept → lead.accept",
  "POST /api/leads/:contactId/decline → lead.decline",
  "POST /api/leads/:contactId/claim → lead.claim",
  "POST /api/leads/:contactId/release → lead.release",
  "POST /api/leads/:contactId/reassign → lead.reassign",
  "POST /api/leads/:contactId/handoff → lead.reassign",
  "POST /api/leads/:contactId/close → contact.view_detail",
  "POST /api/leads/:contactId/reopen → contact.view_detail",
  "POST /api/leads/:contactId/merge → contact.view_detail",
  "POST /api/leads/:contactId/delete → contact.view_detail",
  "GET /api/ponds/:id/cards → contact.view",
  "HEAD /api/ponds/:id/cards → contact.view",
  "POST /api/members/:userId/deactivate → member.remove",
]
`;
