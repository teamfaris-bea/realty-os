exports[`api/workspace route table and schemas > every workspace route declares its authorization; Action routes carry authorize(<that action>) (snapshot) 1`] = `
[
  "DELETE /api/deals/:id/members/:userId deal.edit authorize(deal.edit)",
  "GET /api/appointments self",
  "GET /api/deals self",
  "GET /api/deals/:id deal.view authorize(deal.view)",
  "GET /api/deals/:id/financials deal.financials authorize(deal.financials)",
  "GET /api/feed self",
  "GET /api/listings self",
  "GET /api/listings/:id listing.view authorize(listing.view)",
  "GET /api/listings/:id/showings listing.view authorize(listing.view)",
  "GET /api/notification-preferences self",
  "GET /api/notifications self",
  "GET /api/search self",
  "GET /api/tasks self",
  "GET /api/tasks/:id self",
  "PATCH /api/appointments/:id self",
  "PATCH /api/deal-dates/:id deal.edit authorize(deal.edit)",
  "PATCH /api/deals/:id deal.edit authorize(deal.edit)",
  "PATCH /api/listings/:id listing.edit authorize(listing.edit)",
  "PATCH /api/showings/:id listing.edit authorize(listing.edit)",
  "PATCH /api/tasks/:id self",
  "POST /api/appointments self",
  "POST /api/appointments/:id/outcome self",
  "POST /api/deals deal.edit authorize(deal.edit)",
  "POST /api/deals/:id/contacts deal.edit authorize(deal.edit)",
  "POST /api/deals/:id/dates deal.edit authorize(deal.edit)",
  "POST /api/deals/:id/members deal.edit authorize(deal.edit)",
  "POST /api/deals/:id/stage deal.edit authorize(deal.edit)",
  "POST /api/feed/:id/dismiss self",
  "POST /api/feed/:id/done self",
  "POST /api/feed/:id/snooze self",
  "POST /api/listings listing.edit authorize(listing.edit)",
  "POST /api/listings/:id/contacts listing.edit authorize(listing.edit)",
  "POST /api/listings/:id/showings listing.edit authorize(listing.edit)",
  "POST /api/notifications/read self",
  "POST /api/showings/:id/feedback listing.edit authorize(listing.edit)",
  "POST /api/tasks self",
  "PUT /api/deals/:id/financials deal.financials authorize(deal.financials)",
  "PUT /api/notification-preferences self",
]
`;
