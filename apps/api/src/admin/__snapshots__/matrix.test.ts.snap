exports[`route table and schemas > every admin route declares an Action and carries authorize(<that action>) (snapshot) 1`] = `
[
  "GET /api/members → settings.routing",
  "HEAD /api/members → settings.routing",
  "POST /api/invites → member.invite",
  "DELETE /api/invites/:id → member.invite",
  "PATCH /api/members/:userId → member.role",
  "GET /api/routing-rules → settings.routing",
  "HEAD /api/routing-rules → settings.routing",
  "POST /api/routing-rules → settings.routing",
  "PUT /api/routing-rules/order → settings.routing",
  "PATCH /api/routing-rules/:id → settings.routing",
  "PUT /api/routing-rules/:id/members → settings.routing",
  "DELETE /api/routing-rules/:id → settings.routing",
  "GET /api/ponds → settings.routing",
  "HEAD /api/ponds → settings.routing",
  "POST /api/ponds → settings.routing",
  "PATCH /api/ponds/:id → settings.routing",
  "PUT /api/ponds/:id/members → settings.routing",
  "DELETE /api/ponds/:id → settings.routing",
  "GET /api/teams → settings.routing",
  "HEAD /api/teams → settings.routing",
  "POST /api/teams → settings.routing",
  "PATCH /api/teams/:id → settings.routing",
  "PUT /api/teams/:id/members → settings.routing",
  "DELETE /api/teams/:id → settings.routing",
  "GET /api/settings → settings.routing",
  "HEAD /api/settings → settings.routing",
  "PATCH /api/settings → settings.routing",
  "PATCH /api/settings/identity → settings.identity",
  "GET /api/compliance-policies → settings.compliance",
  "HEAD /api/compliance-policies → settings.compliance",
  "POST /api/compliance-policies → settings.compliance",
  "POST /api/compliance-policies/:id/activate → settings.compliance",
]
`;
