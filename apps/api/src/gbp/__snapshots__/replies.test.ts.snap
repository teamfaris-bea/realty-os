      "additionalProperties": false,
      "properties": {
        "body": {
          "type": [
            "string",
            "null",
          ],
        },
        "connectionId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "draft": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "actionId": {
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string",
                },
                "byAssistant": {
                  "type": "boolean",
                },
                "guard": {
                  "items": {
                    "enum": [
                      "REVIEWER_NAME",
                      "MONEY",
                      "ADDRESS",
                      "DATE",
                      "CONTACT",
                      "DEAL",
                      "FAIR_HOUSING",
                      "LENGTH",
                    ],
                    "type": "string",
                  },
                  "type": "array",
                },
                "text": {
                  "type": "string",
                },
              },
              "required": [
                "actionId",
                "text",
                "guard",
                "byAssistant",
              ],
              "type": "object",
            },
            {
              "type": "null",
            },
          ],
        },
        "id": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "rating": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer",
            },
            {
              "type": "null",
            },
          ],
        },
        "reviewedAt": {
          "type": "string",
        },
        "reviewerDisplay": {
          "type": [
            "string",
            "null",
          ],
        },
        "state": {
          "enum": [
            "needs_reply",
            "draft_waiting",
            "posting",
            "checking",
            "replied",
            "replied_outside",
            "removed",
          ],
          "type": "string",
        },
        "stateLabel": {
          "type": "string",
        },
      },
      "required": [
        "id",
        "connectionId",
        "rating",
        "body",
        "reviewerDisplay",
        "reviewedAt",
        "state",
        "stateLabel",
        "draft",
      ],
      "type": "object",
    },
    "sentence": {
      "type": "string",
    },
  },
  "required": [
    "review",
    "outcome",
    "sentence",
  ],
  "type": "object",
}
