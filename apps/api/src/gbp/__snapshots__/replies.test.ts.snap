exports[`the one tap (R-GBP-1, R-GBP-4) > R-GBP-1: every review response is snapshotted: no tenant id, no confidence, no contact > ReplyResponse 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "outcome": {
      "enum": [
        "replied",
        "failed",
        "unknown",
      ],
      "type": "string",
    },
