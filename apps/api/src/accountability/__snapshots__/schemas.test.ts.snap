exports[`api/accountability route table and schemas > R-PERM-1: every accountability route declares a core Action and carries authorize(<that action>) (snapshot) 1`] = `
[
  "GET /api/scoreboard scoreboard.view authorize(scoreboard.view)",
  "GET /api/team/exceptions exception.view authorize(exception.view)",
  "GET /api/team/exceptions/:dedupeKey exception.view authorize(exception.view)",
  "GET /api/team/momentum scoreboard.view authorize(scoreboard.view)",
  "GET /api/team/scoreboard scoreboard.view authorize(scoreboard.view)",
  "POST /api/team/exceptions/:dedupeKey/reassign exception.reassign authorize(exception.reassign)",
  "POST /api/team/exceptions/:dedupeKey/reopen exception.resolve authorize(exception.resolve)",
  "POST /api/team/exceptions/:dedupeKey/resolve exception.resolve authorize(exception.resolve)",
  "POST /api/team/exceptions/:dedupeKey/verify exception.verify authorize(exception.verify)",
]
`;
